{
  "expo": {
    "name": "ContaCerta",
    "slug": "ContaCerta",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "C:/Users/mario/ContaCerta/assets/images/logo-contacerta.png",

    "scheme": "contacerta",

    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "assets/images/logo-contacerta.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#130B25",
        "foregroundImage": "C:/Users/mario/ContaCerta/assets/images/logo conta certa.png",
        "backgroundImage": "C:/Users/mario/ContaCerta/assets/images/logo conta certa.png",
        "monochromeImage": "C:/Users/mario/ContaCerta/assets/images/logo conta certa.png"
      },

      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "assets/images/logo-contacerta.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#130B25",
          "image": "assets/images/logo-contacerta.png",
          "imageWidth": 161,
          "resizeMode": "contain"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}